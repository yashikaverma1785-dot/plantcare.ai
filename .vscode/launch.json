{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PlantCare AI: FastAPI Server (Port 8000)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "PlantCare AI: Full App Runner (run.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome (Vite Dev - Port 5173)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome (FastAPI App - Port 8000)",
            "url": "http://127.0.0.1:8000",
            "webRoot": "${workspaceFolder}/frontend/dist"
        }
    ]
}
